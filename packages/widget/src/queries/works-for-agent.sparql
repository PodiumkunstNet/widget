PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdaw: <http://rdaregistry.info/Elements/w/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?work ?title
WHERE {
	VALUES ?agent { <{{iri}}> }
	{
		?work rdaw:P10053 ?agent.
	}
	UNION
	{
		?work rdaw:P10205 ?agent.
	}
	UNION
	{
		?work rdaw:P10060 ?agent.
	}
	OPTIONAL {
		?work rdaw:P10223 ?title.
	}
}
OFFSET 0
LIMIT 10000