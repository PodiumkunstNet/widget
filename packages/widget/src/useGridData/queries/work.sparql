PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdaw:   <http://rdaregistry.info/Elements/w/>
PREFIX rdae:   <http://rdaregistry.info/Elements/e/>
PREFIX rdam:   <http://rdaregistry.info/Elements/m/>
PREFIX rdaa:   <http://rdaregistry.info/Elements/a/>
PREFIX rdat:   <http://rdaregistry.info/Elements/t/>
PREFIX dcterms:<http://purl.org/dc/terms/>
PREFIX dc:     <http://purl.org/dc/elements/1.1/>

SELECT DISTINCT
	?work
	(COALESCE(?preftitle, ?worktitle) AS ?title)
	?language
	?duration
	?date
	?note
	?keywords
	?category
	?categoryname
	?category
	?composer
	?composername
	?librettist
	?librettistname
	?choreographer
	?choreographername
	?choreographer 
	?author
	?authorname
	?producer
	?producername
	?director
	?directorname
	?dedicatee
	?dedicateename
	?commissioning
	?commissioningname
	?creator
	?creatorname
	?collectiveagentname
	?collectiveagent 
	?source
WHERE {
	VALUES ?work { <{{iri}}> }

	# Core metadata
	OPTIONAL { ?work rdaw:P10223 ?preftitle . }
	OPTIONAL { ?work rdaw:P10088 ?worktitle . }
	OPTIONAL { ?work rdaw:P10353 ?language . }
	OPTIONAL { ?work rdaw:P10351 ?duration . }
	OPTIONAL { ?work rdaw:P10219 ?date . }
	OPTIONAL { ?work dcterms:description ?note . }
	OPTIONAL { ?work rdaw:P10330 ?keywords . }

	# Category (Dutch label)
	OPTIONAL {
		?work rdaw:P10004 ?category .
		OPTIONAL {
		?category skos:prefLabel ?categoryname .
		FILTER ( LANGMATCHES(LANG(?categoryname), "nl") )
		}
	}

	# Agents – each uses a property path to grab either an RDA name or a SKOS label
	OPTIONAL {
		?work rdaw:P10053 ?composer .
		OPTIONAL { ?composer (rdaa:P50385) ?composername . }
	}
	OPTIONAL {
		?work rdaw:P10205 ?librettist .
		OPTIONAL { ?librettist (rdaa:P50385) ?librettistname . }
	}
	OPTIONAL {
		?work rdaw:P10060 ?choreographer .
		OPTIONAL { ?choreographer (rdaa:P50385) ?choreographername . }
	}
	OPTIONAL {
		?work rdaw:P10061 ?author .
		OPTIONAL { ?author (rdaa:P50385) ?authorname . }
	}
	OPTIONAL {
		?work rdaw:P10064 ?producer .
		OPTIONAL { ?producer (rdaa:P50385) ?producername . }
	}
	OPTIONAL {
		?work rdaw:P10066 ?director .
		OPTIONAL { ?director (rdaa:P50385) ?directorname . }
	}
	OPTIONAL {
		?work rdaw:P10069 ?dedicatee .
		OPTIONAL { ?dedicatee (rdaa:P50385) ?dedicateename . }
	}
	OPTIONAL {
		?work rdaw:P10287 ?commissioning .
		OPTIONAL { ?commissioning (rdaa:P50385) ?commissioningname . }
	}
	OPTIONAL {
		?work rdaw:P10437 ?creator .
		OPTIONAL { ?creator (rdaa:P50385) ?creatorname . }
	}
	OPTIONAL {
		?work rdaw:P10315 ?collectiveagent .
		OPTIONAL { ?collectiveagent (rdaa:P50385) ?collectiveagentname . }
	}

	# Source
	OPTIONAL { ?work dcterms:source ?source . }
}